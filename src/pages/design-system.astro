---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
const palette = [
 {n:'Navy',h:'#17324D',v:'--brand-navy',light:false},
 {n:'Blue',h:'#2878B5',v:'--brand-blue',light:false},
 {n:'Electric',h:'#1F6FE5',v:'--brand-electric',light:false},
 {n:'Teal',h:'#258A78',v:'--brand-teal',light:false},
 {n:'Coral',h:'#F0835E',v:'--brand-coral',light:true},
 {n:'Canvas',h:'#F7F9FA',v:'--bg-canvas',light:true},
 {n:'Soft',h:'#EAF2F5',v:'--bg-soft',light:true},
 {n:'Surface',h:'#FFFFFF',v:'--bg-surface',light:true},
];
---
<BaseLayout title="Design System — AMZ Data Software" ambient={false}>
 <div class="ds-hero container"><span class="section-eyebrow">AMZ / FUNDAÇÃO VISUAL</span><h1>Design System <small>v0.1</small></h1><p class="section-description">Uma linguagem clara, humana e confiável — construída antes de expandir a landing page.</p><div class="ds-status">DIREÇÃO RECUPERADA · CONTEÚDO E LOGOTIPO A VALIDAR</div></div>
 <section class="ds-section container"><div class="ds-heading"><span>01</span><h2>Cores & superfícies</h2></div><div class="palette">{palette.map(c=><div class="swatch"><div class="swatch-color" style={`background:${c.h};color:${c.light?'#17324D':'white'}`}><span>{c.n}</span></div><div class="swatch-caption"><strong>{c.h}</strong><code>{c.v}</code></div></div>)}</div><p class="ds-note">O coral é acento decorativo; textos corridos devem usar navy/blue com contraste verificado.</p></section>
 <section class="ds-section container"><div class="ds-heading"><span>02</span><h2>Tipografia</h2></div><div class="type-examples"><div class="type-hero">Clareza muda<br /><em>perspectivas.</em></div><p class="type-body">Interfaces e mensagens devem ser legíveis, diretas e próximas de quem usa. A tipografia carrega hierarquia, não ruído.</p><div class="type-mono">0123456789 — LABEL / AMZ DATA SOFTWARE</div></div></section>
 <section class="ds-section container"><div class="ds-heading"><span>03</span><h2>Componentes</h2></div><div class="component-samples"><Button href="/" label="Ação primária" /><Button href="/" label="Ação secundária" variant="secondary" /><span class="section-eyebrow">ETIQUETA EDITORIAL</span></div><div class="surface-examples"><div class="sample surface"><span>SUPERFÍCIE / DEFAULT</span><h3>Informação com foco.</h3><p>Ritmo visual sem excesso de decoração.</p></div><div class="sample dark"><span>SUPERFÍCIE / INVERSA</span><h3>Contraste com intenção.</h3><p>Usar blocos escuros apenas quando agregarem hierarquia.</p></div></div></section>
 <section class="ds-section container"><div class="ds-heading"><span>04</span><h2>Regras de movimento</h2></div><div class="motion-rules"><p>Revelação curta: 720ms</p><p>Hover funcional: 160–320ms</p><p>Atmosfera: lenta, sem partículas decorativas</p><p>Rolagem: nativa, nunca bloqueada</p><p>Acessibilidade: respeitar movimento reduzido</p></div></section>
</BaseLayout>
<style>
.ds-hero { padding:6rem 0 5rem; }h1{font:700 clamp(3.5rem,9vw,8rem)/1 var(--font-display);letter-spacing:-.09em;margin:1.4rem 0 1.5rem}h1 small{font:700 .14em var(--font-mono);letter-spacing:0;vertical-align:top;margin-left:.8rem;color:var(--brand-blue)}.ds-status{margin-top:2.3rem;color:var(--brand-blue);font:.68rem var(--font-mono);letter-spacing:.08em}
.ds-section{padding:4rem 0;border-top:1px solid var(--border-subtle)}.ds-heading{display:flex;gap:2rem;align-items:baseline;margin-bottom:2.3rem}.ds-heading>span{font:.74rem var(--font-mono);color:var(--brand-blue)}h2{font:650 clamp(2rem,4vw,3.7rem) var(--font-display);letter-spacing:-.06em;margin:0}.palette{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.75rem}.swatch{background:white;border:1px solid var(--border-subtle);border-radius:var(--radius-sm);overflow:hidden}.swatch-color{height:148px;padding:1rem;display:flex;align-items:end;font:600 .75rem var(--font-mono);text-transform:uppercase}.swatch-caption{display:flex;flex-direction:column;gap:.4rem;padding:1rem;font-size:.8rem}.swatch-caption code{font-size:.66rem;color:var(--text-secondary)}.ds-note{color:var(--text-secondary);margin-top:1.5rem;font-size:.9rem}
.type-examples{padding:3rem;background:white;border:1px solid var(--border-subtle);border-radius:var(--radius-md)}.type-hero{font:650 clamp(2.8rem,7vw,7rem)/1 var(--font-display);letter-spacing:-.075em}.type-hero em{color:var(--brand-blue);font:normal italic 1em Georgia,serif}.type-body{font-size:1.25rem;color:var(--text-secondary);line-height:1.6;max-width:34rem;margin:3rem 0}.type-mono{font:.7rem var(--font-mono);letter-spacing:.14em;color:var(--brand-teal)}.component-samples{display:flex;gap:1rem;align-items:center;flex-wrap:wrap;margin-bottom:2rem}.surface-examples{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.sample{padding:2.5rem;border-radius:var(--radius-md);min-height:260px}.sample>span{font:.67rem var(--font-mono);letter-spacing:.13em}.sample h3{font:650 clamp(1.65rem,3vw,2.4rem) var(--font-display);letter-spacing:-.05em;margin:2rem 0 1rem}.sample p{max-width:22rem;line-height:1.6}.surface{background:white;border:1px solid var(--border-subtle)}.dark{background:var(--brand-navy);color:white}.dark p{color:#d0e0e9}.motion-rules{display:grid;grid-template-columns:1fr 1fr;gap:.7rem}.motion-rules p{margin:0;border-bottom:1px solid var(--border-subtle);padding:1rem 0;color:var(--text-secondary)}
@media(max-width:800px){.palette{grid-template-columns:repeat(2,minmax(0,1fr))}.surface-examples,.motion-rules{grid-template-columns:1fr}.type-examples{padding:1.5rem}.ds-hero{padding:4rem 0}}
</style>
