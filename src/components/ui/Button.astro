---
interface Props { href: string; variant?: 'primary' | 'secondary' | 'light'; label: string; external?: boolean; }
const { href, variant = 'primary', label, external = false } = Astro.props;
---
<a href={href} class:list={['amz-button', variant, 'hero-cta']} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
  <span>{label}</span><span class="arrow" aria-hidden="true">↗</span>
</a>
<style>
.amz-button { display:inline-flex; align-items:center; justify-content:space-between; gap:2.7rem; min-height: 52px; padding: .9rem 1.15rem; border-radius:var(--radius-sm); font-size:.87rem; font-weight:700; transition:transform var(--duration-base) var(--ease-standard),background var(--duration-base); }
.hero-cta { min-height:58px; padding:1rem 1.2rem; gap:2rem; border-radius:6px; font-size:.9rem; letter-spacing:-.01em; font-weight:650; }
.hero-cta.primary { position:relative; background:linear-gradient(115deg,#17324d,#204968); box-shadow:0 10px 24px color-mix(in srgb,var(--brand-navy) 16%,transparent); }
.hero-cta.primary::before { content:''; width:5px; height:5px; border-radius:50%; background:var(--brand-coral); position:absolute; top:11px; left:12px; pointer-events:none; }
.hero-cta.secondary { border-color:color-mix(in srgb,var(--brand-navy) 23%,transparent); background:color-mix(in srgb,var(--bg-surface) 42%,transparent); }
.hero-cta.secondary:hover { background:var(--bg-surface); border-color:color-mix(in srgb,var(--brand-navy) 42%,transparent); }
.hero-cta:focus-visible { outline:3px solid var(--focus-ring); outline-offset:4px; }
.hero-cta:active { transform:translateY(0) scale(.99); }
.amz-button:hover { transform:translateY(-2px); }
.primary { background:var(--brand-navy); color:white; }
.primary:hover { background:#244d70; }
.secondary { background:transparent; border:1px solid #9fb5c3; color:var(--brand-navy); }
.secondary:hover { background:white; }
.light { background:white; color:var(--brand-navy); }
.arrow { font-size:1.15rem; font-weight:400; transition:transform var(--duration-base) var(--ease-standard); }
.amz-button:hover .arrow { transform:translate(3px,-3px); }
@media(prefers-reduced-motion:reduce){.amz-button:hover,.amz-button:hover .arrow{transform:none}}
@media(max-width:560px){.hero-cta{min-height:54px;padding:.9rem 1rem;font-size:.875rem}}
</style>
