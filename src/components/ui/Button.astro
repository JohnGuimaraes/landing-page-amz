---
interface Props { href: string; variant?: 'primary' | 'secondary' | 'light'; label: string; external?: boolean; }
const { href, variant = 'primary', label, external = false } = Astro.props;
---
<a href={href} class:list={['amz-button', variant]} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
  <span>{label}</span><span class="arrow" aria-hidden="true">↗</span>
</a>
<style>
.amz-button { display:inline-flex; align-items:center; justify-content:space-between; gap:2.7rem; min-height: 52px; padding: .9rem 1.15rem; border-radius:var(--radius-sm); font-size:.87rem; font-weight:700; transition:transform var(--duration-base) var(--ease-standard),background var(--duration-base); }
.amz-button:hover { transform:translateY(-2px); }
.primary { background:var(--brand-navy); color:white; }
.primary:hover { background:#244d70; }
.secondary { background:transparent; border:1px solid #9fb5c3; color:var(--brand-navy); }
.secondary:hover { background:white; }
.light { background:white; color:var(--brand-navy); }
.arrow { font-size:1.15rem; font-weight:400; transition:transform var(--duration-base) var(--ease-standard); }
.amz-button:hover .arrow { transform:translate(3px,-3px); }
</style>
