<div class="atmosphere atmosphere--global" aria-hidden="true">
  <div class="ambient-fallback"></div>
  <canvas id="ambient-canvas" data-ambient-canvas></canvas>
</div>
<style>
.atmosphere--global { position:fixed; z-index:var(--layer-ambient); inset:0; overflow:hidden; pointer-events:none; }
.ambient-fallback { position:absolute; inset:-12%; background:radial-gradient(ellipse 46% 50% at 82% 22%,rgba(87,166,190,.18),transparent 72%),radial-gradient(ellipse 42% 54% at 18% 82%,rgba(37,138,120,.11),transparent 75%); transition:opacity .3s ease; }
canvas { position:absolute; inset:0; width:100%; height:100%; display:block; opacity:.8; }
@media(max-width:640px){canvas{display:none}.ambient-fallback{opacity:.7}}
</style>
