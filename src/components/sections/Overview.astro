---
const capabilities = [
  {
    number: '01',
    label: 'Estratégia tecnológica',
    headline: 'Começar pelo problema. Não pela ferramenta.',
    description: 'Compreender a operação, identificar oportunidades e definir caminhos tecnológicos alinhados às necessidades do negócio.',
    objective: 'Transformar desafios empresariais em uma direção tecnológica clara.',
    kind: 'strategy',
  },
  {
    number: '02',
    label: 'Engenharia de IA',
    headline: 'Inteligência artificial com aplicação real.',
    description: 'Investigar e desenvolver aplicações de IA voltadas a necessidades concretas, considerando o contexto operacional e os objetivos da empresa.',
    objective: 'Aplicar inteligência artificial onde ela pode gerar valor para o negócio.',
    kind: 'ai',
  },
  {
    number: '03',
    label: 'Automação inteligente',
    headline: 'Menos tarefas repetitivas. Mais foco no essencial.',
    description: 'Estruturar processos e explorar oportunidades de automação para reduzir atividades manuais e melhorar o funcionamento das operações.',
    objective: 'Aumentar a eficiência e a consistência dos fluxos de trabalho.',
    kind: 'automation',
  },
  {
    number: '04',
    label: 'Integrações',
    headline: 'Sistemas conectados. Operações mais fluidas.',
    description: 'Desenvolver conexões entre ferramentas, processos e informações para reduzir a fragmentação e favorecer operações integradas.',
    objective: 'Melhorar a comunicação e a circulação de dados entre sistemas.',
    kind: 'integration',
  },
  {
    number: '05',
    label: 'Inteligência de dados',
    headline: 'Transformar informação em conhecimento.',
    description: 'Organizar e explorar dados relevantes para apoiar a compreensão das operações e oferecer melhores condições para a tomada de decisões.',
    objective: 'Apoiar decisões empresariais com informações estruturadas.',
    kind: 'data',
  },
  {
    number: '06',
    label: 'Engenharia e evolução',
    headline: 'Tecnologia preparada para acompanhar o negócio.',
    description: 'Projetar, integrar e evoluir soluções tecnológicas considerando as necessidades atuais e as mudanças que surgem ao longo do tempo.',
    objective: 'Sustentar a evolução tecnológica das operações.',
    kind: 'evolution',
  },
];
---

<section id="visao" class="section capabilities" aria-labelledby="capabilities-title">
  <div class="container capabilities-inner">
    <header class="capabilities-heading">
      <div class="capabilities-heading-main">
        <span class="section-eyebrow">02 / Capacidades tecnológicas</span>
        <h2 id="capabilities-title" class="section-title">Tecnologia aplicada. <span>Impacto no que importa.</span></h2>
      </div>
      <div class="capabilities-intro">
        <p>Engenharia, inteligência artificial e automação conectadas aos desafios de cada negócio. Diferentes competências, um mesmo princípio: a tecnologia deve ter uma razão para existir.</p>
        <small>Proposta editorial · capacidades sujeitas à validação institucional</small>
      </div>
    </header>

    <div class="capability-deck" data-capability-accordion role="group" aria-label="Capacidades tecnológicas da AMZ" aria-roledescription="acordeão">
      {capabilities.map((capability, index) => (
        <article
          class:list={["capability-card", { "is-active": index === 0 }]}
          data-capability-card
          data-capability-kind={capability.kind}
          data-active={index === 0 ? 'true' : 'false'}
        >
          <button
            class="capability-trigger"
            id={`capability-trigger-${capability.number}`}
            type="button"
            aria-expanded={index === 0 ? 'true' : 'false'}
            aria-controls={`capability-panel-${capability.number}`}
            data-capability-trigger
          >
            <span class="capability-number">{capability.number}<span aria-hidden="true"> / 06</span></span>
            <span class="capability-rail-title">{capability.label}</span>
            <span class="capability-plus" aria-hidden="true">+</span>
            <span class="capability-progress" aria-hidden="true"></span>
          </button>

          <div
            class="capability-panel"
            id={`capability-panel-${capability.number}`}
            role="region"
            aria-labelledby={`capability-trigger-${capability.number}`}
            aria-hidden={index === 0 ? 'false' : 'true'}
            inert={index === 0 ? undefined : true}
            data-capability-panel
          >
            <div class="capability-copy">
              <span class="capability-kicker">CAPACIDADE <span>{capability.number}</span></span>
              <h3>{capability.headline}</h3>
              <p>{capability.description}</p>
              <div class="capability-objective">
                <span>OBJETIVO</span>
                <p>{capability.objective}</p>
              </div>
              <a class="capability-link" href="#contato" aria-label={`Conversar sobre ${capability.label}`}>
                <span>Conversar sobre esta frente</span><span aria-hidden="true">↗</span>
              </a>
            </div>

            <div class="capability-visual" aria-hidden="true">
              <span class="visual-index">AMZ <i></i> {capability.number}</span>
              {capability.kind === 'strategy' && (
                <svg class="capability-graphic graphic-strategy" viewBox="0 0 480 330" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path class="strategy-route route-a" d="M36 65C128 65 118 157 229 157" />
                  <path class="strategy-route route-b" d="M36 157H229" />
                  <path class="strategy-route route-c" d="M36 249C128 249 118 157 229 157" />
                  <path class="strategy-final" d="M229 157H402" />
                  <circle class="strategy-origin origin-a" cx="37" cy="65" r="8" />
                  <circle class="strategy-origin origin-b" cx="37" cy="157" r="8" />
                  <circle class="strategy-origin origin-c" cx="37" cy="249" r="8" />
                  <circle class="strategy-focus" cx="229" cy="157" r="24" />
                  <path class="strategy-arrow" d="M402 146L423 157L402 168" />
                  <text x="36" y="40">NECESSIDADES</text><text x="277" y="132">DIREÇÃO</text>
                </svg>
              )}
              {capability.kind === 'ai' && (
                <svg class="capability-graphic graphic-ai" viewBox="0 0 480 330" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path class="ai-input" d="M32 94H112M32 131H96M32 168H120M32 205H101M32 242H112" />
                  <path class="ai-bridge" d="M119 168H167" />
                  <rect class="ai-core" x="167" y="106" width="142" height="124" rx="22" />
                  <path class="ai-core-mark" d="M209 148H267M209 168H256M209 188H244" />
                  <circle class="ai-core-light" cx="288" cy="126" r="4" />
                  <path class="ai-output" d="M309 168H372M372 168L403 137M372 168L403 199" />
                  <rect class="ai-result result-main" x="403" y="125" width="42" height="24" rx="12" />
                  <rect class="ai-result result-upper" x="403" y="187" width="30" height="24" rx="12" />
                  <text x="168" y="86">PROCESSAMENTO</text><text x="32" y="282">CONTEXTO</text><text x="386" y="238">APLICAÇÃO</text>
                </svg>
              )}
              {capability.kind === 'automation' && (
                <svg class="capability-graphic graphic-automation" viewBox="0 0 480 330" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path class="automation-track" d="M72 165H408" />
                  <path class="automation-progress" d="M72 165H408" />
                  <g class="automation-step step-one"><rect x="52" y="125" width="86" height="80" rx="18"/><path d="M76 151H113M76 168H105M76 185H96"/></g>
                  <g class="automation-step step-two"><rect x="197" y="125" width="86" height="80" rx="18"/><path d="M221 151H258M221 168H250M221 185H241"/></g>
                  <g class="automation-step step-three"><rect x="342" y="125" width="86" height="80" rx="18"/><path d="M366 151H403M366 168H395M366 185H386"/></g>
                  <circle class="automation-signal" cx="72" cy="165" r="6" />
                  <text x="52" y="235">IDENTIFICAR</text><text x="197" y="235">ESTRUTURAR</text><text x="342" y="235">FLUIR</text>
                </svg>
              )}
              {capability.kind === 'integration' && (
                <svg class="capability-graphic graphic-integration" viewBox="0 0 480 330" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path class="integration-flow flow-one" d="M38 93H154C196 93 190 165 240 165H433" />
                  <path class="integration-flow flow-two" d="M38 165H433" />
                  <path class="integration-flow flow-three" d="M38 237H154C196 237 190 165 240 165" />
                  <rect class="integration-system system-one" x="31" y="77" width="14" height="32" rx="7" />
                  <rect class="integration-system system-two" x="31" y="149" width="14" height="32" rx="7" />
                  <rect class="integration-system system-three" x="31" y="221" width="14" height="32" rx="7" />
                  <circle class="integration-joint" cx="240" cy="165" r="18" />
                  <circle class="integration-target" cx="433" cy="165" r="8" />
                  <text x="31" y="56">SISTEMAS</text><text x="334" y="145">OPERAÇÃO CONECTADA</text>
                </svg>
              )}
              {capability.kind === 'data' && (
                <svg class="capability-graphic graphic-data" viewBox="0 0 480 330" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <g class="data-cloud">
                    <circle cx="74" cy="103" r="6"/><circle cx="125" cy="78" r="5"/><circle cx="164" cy="124" r="7"/><circle cx="99" cy="162" r="4"/><circle cx="51" cy="197" r="5"/><circle cx="145" cy="211" r="4"/>
                  </g>
                  <path class="data-gather" d="M174 147H240" />
                  <circle class="data-core" cx="260" cy="147" r="27" />
                  <path class="data-order" d="M287 147H334" />
                  <g class="data-cluster cluster-one"><circle cx="354" cy="112" r="6"/><circle cx="378" cy="112" r="6"/><circle cx="402" cy="112" r="6"/></g>
                  <g class="data-cluster cluster-two"><circle cx="354" cy="147" r="6"/><circle cx="378" cy="147" r="6"/><circle cx="402" cy="147" r="6"/></g>
                  <g class="data-cluster cluster-three"><circle cx="354" cy="182" r="6"/><circle cx="378" cy="182" r="6"/><circle cx="402" cy="182" r="6"/></g>
                  <text x="51" y="238">INFORMAÇÃO</text><text x="329" y="220">ESTRUTURA</text>
                </svg>
              )}
              {capability.kind === 'evolution' && (
                <svg class="capability-graphic graphic-evolution" viewBox="0 0 480 330" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path class="evolution-axis" d="M70 253H412" />
                  <g class="evolution-module module-one"><rect x="79" y="174" width="91" height="79" rx="14"/><path d="M99 198H150M99 217H138"/></g>
                  <g class="evolution-module module-two"><rect x="194" y="132" width="91" height="121" rx="14"/><path d="M214 156H265M214 175H253M214 206H265M214 225H247"/></g>
                  <g class="evolution-module module-three"><rect x="309" y="88" width="91" height="165" rx="14"/><path d="M329 112H380M329 131H368M329 162H380M329 181H362M329 212H380M329 231H365"/></g>
                  <path class="evolution-connector" d="M170 214H194M285 192H309" />
                  <text x="78" y="286">EVOLUÇÃO CONTÍNUA</text>
                </svg>
              )}
              <span class="visual-caption">{capability.kind === 'strategy' ? 'da complexidade à direção' : capability.kind === 'ai' ? 'contexto em aplicação' : capability.kind === 'automation' ? 'processo em continuidade' : capability.kind === 'integration' ? 'informação em circulação' : capability.kind === 'data' ? 'dados em estrutura' : 'evolução com organização'}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-capability-accordion]').forEach((deck) => {
    const cards = Array.from(deck.querySelectorAll<HTMLElement>('[data-capability-card]'));
    const triggers = cards.map((card) => card.querySelector<HTMLButtonElement>('[data-capability-trigger]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const mobile = window.matchMedia('(max-width: 900px)');
    let activeIndex = 0;
    let timer: number | undefined;
    let hoverTimer: number | undefined;
    const listenerCleanups: Array<() => void> = [];
    let inView = false;
    let hovered = false;
    let focused = false;
    let manuallyPaused = false;
    let destroyed = false;

    const clearTimer = () => {
      if (timer !== undefined) window.clearTimeout(timer);
      timer = undefined;
      deck.classList.remove('is-counting');
    };

    const clearHover = () => {
      if (hoverTimer !== undefined) window.clearTimeout(hoverTimer);
      hoverTimer = undefined;
    };

    const setActive = (nextIndex: number) => {
      if (nextIndex < 0 || nextIndex >= cards.length || nextIndex === activeIndex) return;
      clearTimer();
      activeIndex = nextIndex;
      deck.style.setProperty('--active-columns', cards.map((_, index) => index === activeIndex ? 'minmax(0, 4.15fr)' : 'minmax(3.35rem, .72fr)').join(' '));
      deck.dataset.activeIndex = String(activeIndex);
      cards.forEach((card, index) => {
        const active = index === activeIndex;
        const trigger = triggers[index];
        const panel = card.querySelector<HTMLElement>('[data-capability-panel]');
        card.classList.toggle('is-active', active);
        card.dataset.active = String(active);
        trigger?.setAttribute('aria-expanded', String(active));
        panel?.setAttribute('aria-hidden', String(!active));
        if (panel) panel.inert = !active;
      });
      deck.dispatchEvent(new CustomEvent('capabilitychange', { bubbles: true, detail: { index: activeIndex } }));
    };

    const canAutoplay = () => !destroyed && !reducedMotion.matches && !mobile.matches && inView && !document.hidden && !hovered && !focused && !manuallyPaused;

    const scheduleNext = (delay = 7000) => {
      clearTimer();
      if (!canAutoplay()) return;
      deck.classList.add('is-counting');
      timer = window.setTimeout(() => {
        timer = undefined;
        if (!canAutoplay()) return;
        setActive((activeIndex + 1) % cards.length);
        scheduleNext();
      }, delay);
    };

    const onPointerEnter = (event: PointerEvent) => {
      if (event.pointerType !== 'mouse') return;
      hovered = true;
      clearTimer();
      clearHover();
      const card = (event.currentTarget as HTMLElement).closest<HTMLElement>('[data-capability-card]');
      const index = card ? cards.indexOf(card) : -1;
      if (index < 0 || focused) return;
      hoverTimer = window.setTimeout(() => {
        hoverTimer = undefined;
        if (!destroyed && hovered && !focused) setActive(index);
      }, 200);
    };
    const onPointerLeave = () => {
      clearHover();
      hovered = false;
      if (!manuallyPaused) scheduleNext(2200);
    };
    const onFocusIn = () => {
      clearHover();
      focused = true;
      clearTimer();
    };
    const onFocusOut = (event: FocusEvent) => {
      if (event.relatedTarget instanceof Node && deck.contains(event.relatedTarget)) return;
      focused = false;
      if (!manuallyPaused) scheduleNext(2200);
    };
    const onVisibilityChange = () => {
      if (document.hidden) { clearTimer(); clearHover(); }
      else scheduleNext();
    };
    const onMotionChange = () => {
      clearHover();
      clearTimer();
      if (reducedMotion.matches) deck.classList.remove('is-counting');
      else scheduleNext();
    };
    const onBreakpointChange = () => {
      clearHover();
      clearTimer();
      scheduleNext();
    };

    cards.forEach((card, index) => {
      const trigger = triggers[index];
      card.addEventListener('pointerenter', onPointerEnter);
      card.addEventListener('pointerleave', clearHover);
      const onTriggerFocus = () => {
        clearHover();
        if (document.activeElement === trigger) setActive(index);
      };
      const onTriggerClick = () => {
        clearHover();
        manuallyPaused = true;
        clearTimer();
        setActive(index);
      };
      const onTriggerKeydown = (event: KeyboardEvent) => {
        let targetIndex: number | undefined;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') targetIndex = (index + 1) % cards.length;
        if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') targetIndex = (index - 1 + cards.length) % cards.length;
        if (event.key === 'Home') targetIndex = 0;
        if (event.key === 'End') targetIndex = cards.length - 1;
        if (targetIndex === undefined) return;
        event.preventDefault();
        clearHover();
        clearTimer();
        manuallyPaused = true;
        triggers[targetIndex]?.focus();
      };
      trigger?.addEventListener('focus', onTriggerFocus);
      trigger?.addEventListener('click', onTriggerClick);
      trigger?.addEventListener('keydown', onTriggerKeydown);
      listenerCleanups.push(() => {
        card.removeEventListener('pointerenter', onPointerEnter);
        card.removeEventListener('pointerleave', clearHover);
        trigger?.removeEventListener('focus', onTriggerFocus);
        trigger?.removeEventListener('click', onTriggerClick);
        trigger?.removeEventListener('keydown', onTriggerKeydown);
      });
    });

    deck.addEventListener('pointerleave', onPointerLeave);
    deck.addEventListener('focusin', onFocusIn);
    deck.addEventListener('focusout', onFocusOut);
    document.addEventListener('visibilitychange', onVisibilityChange);
    reducedMotion.addEventListener('change', onMotionChange);
    mobile.addEventListener('change', onBreakpointChange);
    const observer = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting && entry.intersectionRatio >= 0.2;
      if (inView) scheduleNext();
      else clearTimer();
    }, { threshold: [0, 0.2, 0.6] });
    observer.observe(deck);
    deck.dataset.activeIndex = '0';

    const destroy = () => {
      if (destroyed) return;
      destroyed = true;
      clearTimer();
      clearHover();
      observer.disconnect();
      document.removeEventListener('visibilitychange', onVisibilityChange);
      reducedMotion.removeEventListener('change', onMotionChange);
      mobile.removeEventListener('change', onBreakpointChange);
      deck.removeEventListener('pointerleave', onPointerLeave);
      deck.removeEventListener('focusin', onFocusIn);
      deck.removeEventListener('focusout', onFocusOut);
      listenerCleanups.forEach((cleanup) => cleanup());
      document.removeEventListener('astro:before-swap', destroy);
      window.removeEventListener('pagehide', destroy);
    };
    document.addEventListener('astro:before-swap', destroy, { once: true });
    window.addEventListener('pagehide', destroy, { once: true });
  });
</script>

<style>
  .capabilities { padding-block: clamp(4.8rem, 7.5vw, 7rem); overflow: hidden; }
  .capabilities-inner { width:min(calc(100% - var(--gutter)*2),1680px); display: grid; gap: clamp(2.5rem, 4vw, 3.5rem); }
  .capabilities-heading { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(16rem, .7fr); align-items: end; gap: clamp(2rem, 6vw, 7rem); }
  .capabilities .section-title { max-width: 16ch; margin-bottom: 0; }
  .capabilities .section-title span { color: var(--brand-blue); }
  .capabilities-intro { max-width: 34rem; padding-bottom: .35rem; }
  .capabilities-intro p { margin: 0; color: var(--text-secondary); font-size: var(--type-lg); line-height: 1.55; }
  .capabilities-intro small { display: block; margin-top: 1rem; color: var(--text-secondary); font: 600 .62rem/1.5 var(--font-mono); letter-spacing: .065em; text-transform: uppercase; }

  .capability-deck { display: grid; grid-template-columns: var(--active-columns, minmax(0, 4.15fr) repeat(5, minmax(3.35rem, .72fr))); gap: .55rem; min-height: 35rem; transition: grid-template-columns 720ms var(--ease-standard); }
  .capability-card { --capability-color: var(--brand-navy); position: relative; min-width: 0; min-height: 35rem; overflow: hidden; isolation: isolate; border: 1px solid color-mix(in srgb, white 25%, transparent); border-radius: var(--radius-md); color: var(--text-inverse); background: var(--capability-color); transition: border-color 420ms var(--ease-standard), background-color 420ms var(--ease-standard); }
  .capability-card:nth-child(2) { --capability-color: var(--brand-blue); }
  .capability-card:nth-child(3) { --capability-color: var(--surface-teal-strong); }
  .capability-card:nth-child(4) { --capability-color: var(--brand-electric); }
  .capability-card:nth-child(5) { --capability-color: var(--brand-navy); }
  .capability-card:nth-child(6) { --capability-color: var(--surface-teal-strong); }
  .capability-card.is-active { border-color: color-mix(in srgb, white 56%, var(--brand-coral)); }

  .capability-trigger { position: absolute; z-index: 4; inset: 0 auto 0 0; display: flex; width: 100%; flex-direction: column; align-items: flex-start; padding: 1.2rem .85rem; border: 0; color: inherit; text-align: left; background: transparent; cursor: pointer; }
  .capability-card.is-active .capability-trigger { width: 3.8rem; }
  .capability-trigger:focus-visible { outline: 3px solid var(--brand-coral); outline-offset: -5px; border-radius: inherit; }
  .capability-number { font: 600 var(--type-micro)/1 var(--font-mono); letter-spacing: .11em; color: #fff; white-space: nowrap; }
  .capability-rail-title { position: absolute; top: 50%; left: 50%; width: max-content; max-width: 21rem; transform: translate(-50%, -50%) rotate(-90deg); font: 600 .82rem/1.2 var(--font-display); letter-spacing: -.02em; white-space: nowrap; transition: opacity 260ms var(--ease-standard); }
  .capability-card.is-active .capability-rail-title { opacity: 0; }
  .capability-plus { position: absolute; left: 50%; bottom: 1.4rem; transform: translateX(-50%); font-size: 1.15rem; font-weight: 300; opacity: .84; transition: transform 360ms var(--ease-standard), opacity 260ms var(--ease-standard); }
  .capability-card.is-active .capability-plus { opacity: 0; transform: translateX(-50%) rotate(45deg); }
  .capability-progress { position: absolute; right: .4rem; bottom: 1.1rem; left: .4rem; height: 2px; overflow: hidden; background: rgba(255,255,255,.16); opacity: 0; }
  .capability-progress::after { position: absolute; inset: 0; content: ''; background: var(--brand-coral); transform: scaleX(0); transform-origin: left; }
  .capability-deck.is-counting .capability-card.is-active .capability-progress { opacity: 1; }
  .capability-deck.is-counting .capability-card.is-active .capability-progress::after { animation: capability-time 7s linear both; }
  @keyframes capability-time { to { transform: scaleX(1); } }

  .capability-panel { position: absolute; inset: 0; display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); align-items: center; gap: clamp(1.1rem, 2vw, 2rem); padding: 3rem clamp(1.6rem, 2.5vw, 2.8rem) 3rem 4.25rem; visibility: hidden; opacity: 0; transition: opacity 260ms var(--ease-standard), visibility 0s linear 720ms; }
  .capability-card.is-active .capability-panel { visibility: visible; opacity: 1; transition: opacity 330ms var(--ease-standard) 330ms, visibility 0s; }
  .capability-copy { position: relative; z-index: 1; max-width: 29rem; transform: translateY(10px); opacity: 0; transition: transform 500ms var(--ease-standard), opacity 320ms var(--ease-standard); }
  .capability-card.is-active .capability-copy { transform: translateY(0); opacity: 1; transition-delay: 300ms; }
  .capability-kicker { display: inline-flex; gap: .5rem; align-items: center; color: #fff; font: 600 var(--type-micro)/1 var(--font-mono); letter-spacing: .12em; }
  .capability-kicker span { color: inherit; }
  .capability-copy h3 { margin: .85rem 0 .7rem; font: 650 clamp(1.45rem, 2.2vw, 2.35rem)/1.04 var(--font-display); letter-spacing: -.05em; text-wrap: balance; }
  .capability-copy > p { max-width: 39ch; margin: 0; color: #fff; font-size: clamp(.88rem, 1vw, 1.02rem); line-height: 1.55; }
  .capability-objective { margin-top: 1rem; padding-left: .75rem; border-left: 2px solid var(--brand-coral); }
