            <path d="M500 190 C580 190 580 72 710 72 H884" pathLength="1" />
            <path d="M500 190 C580 190 580 308 710 308 H884" pathLength="1" />
          </svg>
          <span class="ecosystem-origin" aria-hidden="true"></span>
          <div class="ecosystem-node ecosystem-node--one"><span>CAPACIDADE</span><strong>Software</strong></div>
          <div class="ecosystem-node ecosystem-node--two"><span>CAPACIDADE</span><strong>Dados</strong></div>
          <div class="ecosystem-node ecosystem-node--three"><span>CAPACIDADE</span><strong>Integrações</strong></div>
          <div class="ecosystem-node ecosystem-node--four"><span>CAPACIDADE</span><strong>Automações</strong></div>
        </div>
