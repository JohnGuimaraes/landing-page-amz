<section id="abordagem" class="section approach"><div class="container">
 <div class="approach-intro" data-reveal><span class="section-eyebrow">04 / ABORDAGEM</span><h2 class="section-title">Clareza em cada <em>etapa.</em></h2><p class="section-description">Estrutura provisória para apresentar a abordagem de trabalho.</p></div>
 <div class="step-list">
   {[{n:'01',name:'Etapa a definir'},{n:'02',name:'Etapa a definir'},{n:'03',name:'Etapa a definir'}].map(step => <div class="step" data-reveal><span>{step.n}</span><h3>{step.name}</h3><p>Conteúdo a validar.</p><span class="step-arrow" aria-hidden="true">↗</span></div>)}
 </div>
</div></section>
<style>
.approach { background:rgba(255,255,255,.78); }.approach-intro{margin-bottom:3.3rem}.approach-intro .section-title{max-width:18ch}.section-title em{font:normal italic 1em Georgia,serif;color:var(--brand-blue)}
.step { display:grid;grid-template-columns:80px 1fr 1fr 32px;align-items:center;gap:1.5rem;border-top:1px solid var(--border-subtle);padding:1.65rem 0; }
.step:last-child{border-bottom:1px solid var(--border-subtle)}.step>span:first-child {font:600 .75rem var(--font-mono);color:var(--brand-blue)}
h3{font:650 clamp(1.5rem,2.8vw,2.7rem)/1.1 var(--font-display);letter-spacing:-.055em;margin:0}
p{color:var(--text-secondary);line-height:1.5}.step-arrow{font-size:1.4rem;color:var(--brand-teal)}
@media(max-width:680px){.step{grid-template-columns:2.5rem 1fr 1.5rem;gap:1rem}.step p{grid-column:2/3;margin:0}.step-arrow{grid-column:3/4;grid-row:1/3}}
</style>
